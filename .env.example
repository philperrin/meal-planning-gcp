# Google Cloud Project Configuration
PROJECT_ID=meal-planning-app-507921
PORT=8080
FLASK_ENV=production
SECRET_KEY=change_this_to_a_secure_random_key_in_production

# Google Gemini API Key
# Starter API key for AI generation (Google AI Studio)
GEMINI_API_KEY=super_secret_key

# Google OAuth 2.0 Web Client Credentials
# Created under GCP Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs (Web application)
GOOGLE_CLIENT_ID=super_secret_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=super_secret_key_2
# Redirect URI should match your Cloud Run URL or local host:
# e.g., http://localhost:8080/auth/callback or https://meal-planning-app-xyz.a.run.app/auth/callback
GOOGLE_REDIRECT_URI=http://localhost:8080/auth/callback

# Storage Mode (drive or local)
STORAGE_MODE=drive
LOCAL_DB_PATH=data/Automated_Meal_Planner_DB.json
